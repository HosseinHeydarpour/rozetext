{
  "name": "rozetext",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "login": "node scripts/login.mjs",
    "login:collect": "node scripts/login.mjs --account=collect",
    "dashboard:data": "node scripts/dashboard-data.mjs",
    "meta:suite": "node scripts/meta-suite.mjs",
    "meta:export": "node scripts/meta-export.mjs",
    "meta:insights": "node scripts/meta-insights.mjs",
    "meta:audience": "node scripts/meta-audience.mjs",
    "meta:ranges": "node scripts/meta-ranges.mjs",
    "meta:content": "node scripts/meta-content.mjs",
    "data:collect": "node scripts/collect-data.mjs",
    "dashboard:data": "node scripts/build-dashboard-data.mjs",
    "dashboard:dev": "npm --prefix dashboard run dev",
    "dashboard:build": "npm --prefix dashboard run build"
  },
  "dependencies": {
    "playwright-core": "^1.65.0"
  }
}
